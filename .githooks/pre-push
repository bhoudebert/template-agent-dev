#!/bin/sh
# Never push to main: every change goes through a branch and a PR (mise run ship), even an emergency.
# Enable once per clone: mise run hooks. A deliberate override is `git push --no-verify`.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: refusing to push to ${remote_ref#refs/heads/}. Use a branch and a PR:" >&2
      echo "  git switch -c fix/<what-is-broken> && mise run ship --emergency" >&2
      exit 1 ;;
  esac
done
exit 0
