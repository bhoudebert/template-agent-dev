{
  "frontmatter": {
    "required": [
      "id",
      "type",
      "title",
      "status",
      "owner"
    ],
    "enums": {
      "status": [
        "draft",
        "enriched",
        "approved",
        "specified",
        "designed",
        "implemented",
        "done"
      ],
      "kind": [
        "feature",
        "bug"
      ]
    },
    "patterns": {
      "id": "^{story}$"
    }
  },
  "sections": [
    "Story",
    "Acceptance criteria",
    "Edge cases",
    "Out of scope",
    "Open questions"
  ],
  "section_patterns": {
    "Acceptance criteria": "(?is)given\\b.*\\bwhen\\b.*\\bthen\\b"
  },
  "relaxed_when": {
    "status": "draft"
  },
  "filename_starts_with": "id",
  "kinds": {
    "bug": {
      "sections": [
        "Symptom",
        "Expected behaviour",
        "Reproduction",
        "Acceptance criteria",
        "Out of scope",
        "Open questions"
      ],
      "section_patterns": {
        "Acceptance criteria": "(?is)given\\b.*\\bwhen\\b.*\\bthen\\b"
      }
    }
  }
}
