# cp .env.example .env   (git-ignored; mise loads it automatically)

# Local model (Ollama / vLLM / llama.cpp / LM Studio)
AGENT_PROVIDER=openai
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=llama3.1
# AGENT_MODEL_STRONG=
# AGENT_MODEL_CHEAP=

# Hosted OpenAI-compatible API
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_API_KEY=sk-...

# Or any CLI that reads the prompt on stdin
# AGENT_PROVIDER=cmd
# AGENT_CMD=claude -p

# Base ref for @diff (qa/review/release)
# AGENT_BASE_REF=origin/main
